# Copy this to .env and fill in real values. Never commit .env.

# AWS Bedrock — bearer token auth (AWS API Key, launched July 2025)
# Generate from: AWS Console → Amazon Bedrock → API Keys → Create API Key
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here
AWS_REGION=ap-south-1
# Use inference profile IDs — on-demand model IDs don't work for newer Claude models
# India region: in.anthropic.claude-sonnet-5, in.anthropic.claude-haiku-4-5-20251001-v1:0
# Global:       global.anthropic.claude-sonnet-4-6, global.anthropic.claude-sonnet-5
BEDROCK_MODEL_ID=in.anthropic.claude-sonnet-5

# Neo4j — must match the password you pass to docker run
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# HuggingFace — for downloading embedding models in Stage 4 RAG pipeline
# Get a read-only token from huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_hf_token_here
