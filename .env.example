# Copy this to .env and fill in real values. Never commit .env.

# Anthropic (Claude API) — get from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neo4j — must match what you passed to docker run
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# GitHub — personal access token, needs repo scope
GITHUB_TOKEN=your_github_token_here

# HuggingFace — for embedding models in Stage 4 RAG pipeline
HUGGINGFACE_TOKEN=your_hf_token_here

# Context7 MCP (optional — works without key but rate limited)
# CONTEXT7_API_KEY=your_context7_key_here
