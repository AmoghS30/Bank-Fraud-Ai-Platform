risk_model/plots/
gnn_model/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Secrets (credentials are passed via docker-compose environment)
.env

# Docs / reports (not needed to run the app)
project-plan/
Reports/
tests/
scripts/
